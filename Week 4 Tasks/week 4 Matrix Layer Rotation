        int m = matrix.size();
        int n = matrix.get(0).size();
        for (int layer = 0; layer < Math.min(m, n) / 2; layer++) {
            int top = layer;
            int left = layer;
            int bottom = m - 1 - layer;
            int right = n - 1 - layer;
            List<Integer> elements = new ArrayList<>();
            // Top row
            for (int j = left; j <= right; j++) {
                elements.add(matrix.get(top).get(j));
            }
            // Right column
            for (int i = top + 1; i <= bottom; i++) {
                elements.add(matrix.get(i).get(right));
            }
            // Bottom row
            for (int j = right - 1; j >= left; j--) {
                elements.add(matrix.get(bottom).get(j));
            }
            // Left column
            for (int i = bottom - 1; i > top; i--) {
                elements.add(matrix.get(i).get(left));
            }
            int size = elements.size();
            int shift = r % size;
            for (int k = 0; k < size; k++) {
                int value = elements.get((k + shift) % size);
                if (k < right - left + 1) {
                    matrix.get(top).set(left + k, value);
                } else if (k < right - left + 1 + bottom - top) {
                    int pos = k - (right - left + 1);
                    matrix.get(top + 1 + pos).set(right, value);
                } else if (k < 2 * (right - left + 1) + bottom - top - 1) {
                    int pos = k - (right - left + 1) - (bottom - top);
                    matrix.get(bottom).set(right - 1 - pos, value);
                } else {
                    int pos = k - 2 * (right - left + 1) - (bottom - top) + 1;
                    matrix.get(bottom - 1 - pos).set(left, value);
                }
            }
        }
        for (List<Integer> row : matrix) {
            for (int j = 0; j < row.size(); j++) {
                System.out.print(row.get(j));
                if (j < row.size() - 1) {
                    System.out.print(" ");
                }
            }
            System.out.println();
        }
