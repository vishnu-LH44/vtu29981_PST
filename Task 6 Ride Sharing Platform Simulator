import java.util.Scanner;

// Exception for invalid ride bookings
class InvalidBookingException extends Exception {
    public InvalidBookingException(String message) {
        super(message);
    }
}
// Base class for all vehicles
abstract class Vehicle {
    protected String vehicleNumber;
    public Vehicle(String vehicleNumber) {
        this.vehicleNumber = vehicleNumber;
    }
    // Polymorphic method for fare calculation
    public abstract double calculateFare(double distance);
}
// Bike vehicle
class Bike extends Vehicle {
    public Bike(String vehicleNumber) {
        super(vehicleNumber);
    }
    @Override
    public double calculateFare(double distance) {
        return distance * 5;
    }
}
// Auto vehicle
class Auto extends Vehicle {
    public Auto(String vehicleNumber) {
        super(vehicleNumber);
    }
    @Override
    public double calculateFare(double distance) {
        return distance * 12;
    }
}
// Cab vehicle
class Cab extends Vehicle {
    public Cab(String vehicleNumber) {
        super(vehicleNumber);
    }
    @Override
    public double calculateFare(double distance) {
        return distance * 12;
    }
}
// Driver class
class Driver {
    private String name;
    private Vehicle vehicle;
    public Driver(String name, Vehicle vehicle) {
        this.name = name;
        this.vehicle = vehicle;
    }
    public Vehicle getVehicle() {
        return vehicle;
    }
}
// Rider class
class Rider {
    private String name;
    public Rider(String name) {
        this.name = name;
    }
}
// Trip class
class Trip {
    private Rider rider;
    private Driver driver;
    private double distance;

    public Trip(Rider rider, Driver driver, double distance)
            throws InvalidBookingException {
        if (distance <= 0) {
            throw new InvalidBookingException(
                "Distance must be greater than zero"
            );
        }
        this.rider = rider;
        this.driver = driver;
        this.distance = distance;
    }
    public double calculateFare() {
        return driver.getVehicle().calculateFare(distance);
    }
}
// Main class
public class RideSharingPlatform {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        Rider rider = new Rider("Customer");
        for (int i = 0; i < n; i++) {
            String rideType = sc.next();
            double distance = sc.nextDouble();
            try {
                Vehicle vehicle;
                // Select vehicle according to ride type
                if (rideType.equalsIgnoreCase("Bike")) {
                    vehicle = new Bike("BIKE001");
                }
                else if (rideType.equalsIgnoreCase("Auto")) {
                    vehicle = new Auto("AUTO001");
                }
                else if (rideType.equalsIgnoreCase("Cab")) {
                    vehicle = new Cab("CAB001");
                }
                else {
                    throw new InvalidBookingException(
                        "Invalid ride type"
                    );
                }

                Driver driver = new Driver("Driver", vehicle);

                Trip trip = new Trip(rider, driver, distance);

                // Display fare
                System.out.println((int) trip.calculateFare());
            }
            catch (InvalidBookingException e) {
                System.out.println("Invalid Booking");
            }
        }
        sc.close();
    }
}
