public static List<Integer> circularPalindromes(String s) {
    int n = s.length();
    String str = s + s;

    int len = 2 * str.length() + 1;
    int[] radius = new int[len];

    // Manacher's algorithm
    int center = 0;
    int right = 0;

    for (int i = 0; i < len; i++) {
        int mirror = 2 * center - i;

        if (i < right) {
            radius[i] = Math.min(right - i, radius[mirror]);
        }

        while (i - radius[i] - 1 >= 0 &&
               i + radius[i] + 1 < len &&
               getChar(str, i - radius[i] - 1) ==
               getChar(str, i + radius[i] + 1)) {
            radius[i]++;
        }

        if (i + radius[i] > right) {
            center = i;
            right = i + radius[i];
        }
    }

    List<Integer> result = new ArrayList<>();

    for (int start = 0; start < n; start++) {
        int left = 2 * start;
        int rightEnd = 2 * (start + n - 1);

        int low = 1;
        int high = n;
        int best = 1;

        while (low <= high) {
            int mid = (low + high) / 2;

            int L = left + mid - 1;
            int R = rightEnd - mid + 1;

            if (hasPalindrome(radius, L, R, mid)) {
                best = mid;
                low = mid + 1;
            } else {
                high = mid - 1;
            }
        }

        result.add(best);
    }

    return result;
}

private static char getChar(String s, int index) {
    if (index % 2 == 0) {
        return '#';
    }
    return s.charAt(index / 2);
}

private static boolean hasPalindrome(int[] radius, int left, int right, int length) {
    if (left > right) {
        return false;
    }

    int mid = (left + right) / 2;

    for (int i = mid; i <= right; i++) {
        if (radius[i] >= length) {
            return true;
        }
    }

    return false;
}
