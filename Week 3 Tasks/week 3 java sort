import java.util.*;

public class Main {
    public static void main(String[] args) {
        int[] numbers = {50, 20, 40, 10, 30};

        System.out.println("Before sorting:");
        for (int n : numbers) {
            System.out.print(n + " ");
        }

        Arrays.sort(numbers);

        System.out.println("\nAfter sorting:");
        for (int n : numbers) {
            System.out.print(n + " ");
        }
    }
}
