public class ArrayPairsAll {
    public static void printAllPairs(int[] arr, int n) {
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                System.out.println("(" + arr[i] + ", " + arr[j] + ")");
            }
        }
    }

    public static void main(String[] args) {
        int[] numbers = {1, 2, 3};
        int n = numbers.length;
        printAllPairs(numbers, n);
    }
}
